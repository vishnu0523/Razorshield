# RazorShield environment. Copy to .env and fill in. NEVER commit .env.

# --- Core ---
DATABASE_URL=sqlite:///./razorshield.db
ARTIFACTS_DIR=./artifacts
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Dataset reproducibility ---
RAZORSHIELD_SEED=42

# --- LLM (optional by design) ---
# The core risk system does NOT depend on this. Leave blank to exercise the
# deterministic explanation path, which is also the demo default.
# Supported providers: anthropic, openai, gemini
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Alternatively, set provider-specific keys:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# "openai" also accepts any host that implements the same chat-completions
# shape -- Groq, OpenRouter, Cerebras, Together -- which is useful when a
# free tier is more generous than the vendor above. Point it elsewhere by
# setting all three of:
#   LLM_PROVIDER=openai
#   OPENAI_API_KEY=<key from that provider>
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_MODEL=llama-3.3-70b-versatile
# (model names are provider-specific; check their docs before demo day)

# --- Razorpay (TEST MODE ONLY) ---
# Keys must start with rzp_test_. Production keys are rejected at startup.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
